{
  "name": "agent-context",
  "version": "0.1.0",
  "description": "Local-first Markdown memory for AI-assisted software development.",
  "type": "module",
  "bin": {
    "agent-context": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && pnpm run lint",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "pack:dry-run": "pnpm run build && rm -rf .tmp-pack && pnpm pack --pack-destination .tmp-pack --json && rm -rf .tmp-pack",
    "lint": "oxlint .",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.68.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "markdown",
    "developer-tools",
    "context",
    "handoff",
    "local-first"
  ],
  "author": "Rowland Ekemezie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowlandekemezie/agent-context.git"
  },
  "bugs": {
    "url": "https://github.com/rowlandekemezie/agent-context/issues"
  },
  "homepage": "https://github.com/rowlandekemezie/agent-context#readme"
}
